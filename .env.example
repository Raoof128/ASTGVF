# API Security Framework - Environment Variables
# Copy this file to .env and fill in your values

# Target API Configuration
TARGET_API_URL=https://api.example.com/graphql
AUTH_TOKEN=Bearer_YOUR_JWT_TOKEN_HERE

# Scanner Configuration
OUTPUT_FORMAT=html
VERIFY_SSL=true
MAX_CONCURRENT=5
TIMEOUT=30

# Report Viewer (Docker)
REPORT_PORT=8080

# Continuous Monitoring
SCAN_INTERVAL=3600  # Seconds between scans (1 hour)

# Notification URLs (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=scanner.log

# Advanced Options
CONFIDENCE_THRESHOLD=0.85
RATE_LIMIT_DELAY=0.1

# Testing Environment
TEST_MODE=false  # Set to true to use mock responses
DRY_RUN=false    # Set to true to skip actual HTTP requests
